
{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ListUploadsOnly",
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::timecapsule-dev-uploads-leopard",
            "Condition": {
                "StringLike": {
                    "s3:prefix": [
                        "uploads/*"
                    ]
                }
            }
        },
        {
            "Sid": "ManageUploads",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject"
            ],
            "Resource": "arn:aws:s3:::timecapsule-dev-uploads-leopard/uploads/*"
        }
    ]
}
